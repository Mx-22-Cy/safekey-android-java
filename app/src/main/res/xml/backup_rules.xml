<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>

    <!--
        SafeKey vault data and key envelopes must not be copied
        through Android Auto Backup.
    -->

    <!-- Primary encrypted vault database. -->
    <exclude
        domain="database"
        path="safekey.db" />
    <exclude
        domain="database"
        path="safekey.db-wal" />
    <exclude
        domain="database"
        path="safekey.db-shm" />
    <exclude
        domain="database"
        path="safekey.db-journal" />

    <!-- Week 10: always-present secondary / Decoy database. -->
    <exclude
        domain="database"
        path="safekey_secondary.db" />
    <exclude
        domain="database"
        path="safekey_secondary.db-wal" />
    <exclude
        domain="database"
        path="safekey_secondary.db-shm" />
    <exclude
        domain="database"
        path="safekey_secondary.db-journal" />

    <!-- Primary vault key envelope. -->
    <exclude
        domain="sharedpref"
        path="safekey_vault_key_envelope.xml" />

    <!-- Week 10: independent Decoy vault key envelope. -->
    <exclude
        domain="sharedpref"
        path="safekey_decoy_vault_key_envelope.xml" />

    <!-- Biometric vault key envelope. -->
    <exclude
        domain="sharedpref"
        path="safekey_biometric_key_envelope.xml" />

</full-backup-content>
