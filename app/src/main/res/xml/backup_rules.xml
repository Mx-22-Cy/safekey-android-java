<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>

    <!--
        SafeKey vault data must not be copied by Android Auto Backup.

        The database is encrypted with a randomly generated key, and the
        envelope contains the password-protected form of that key. These
        files must remain under SafeKey's controlled recovery process.
    -->
    <exclude
        domain="database"
        path="safekey.db" />

    <exclude
        domain="sharedpref"
        path="safekey_vault_key_envelope.xml" />

</full-backup-content>
