<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardAlertCredential"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/alerts_card_min_height"
    android:background="@drawable/alerts_attention_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/alerts_card_padding_horizontal"
    android:paddingEnd="@dimen/alerts_card_padding_horizontal"
    android:paddingTop="@dimen/alerts_card_padding_vertical"
    android:paddingBottom="@dimen/alerts_card_padding_vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Credential information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Credential name and occurrence count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textAlertCredentialName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/vault_text_primary"
                android:textSize="@dimen/alerts_card_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAlertOccurrences"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/alerts_card_chevron_gap"
                android:background="@drawable/dashboard_preview_badge"
                android:paddingStart="@dimen/alerts_occurrence_badge_padding_horizontal"
                android:paddingEnd="@dimen/alerts_occurrence_badge_padding_horizontal"
                android:paddingTop="@dimen/alerts_occurrence_badge_padding_vertical"
                android:paddingBottom="@dimen/alerts_occurrence_badge_padding_vertical"
                android:textColor="@color/dashboard_alert_text"
                android:textSize="@dimen/alerts_occurrence_badge_text_size"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Breach-check status -->
        <TextView
            android:id="@+id/textAlertCredentialStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/alerts_card_title_message_gap"
            android:textColor="@color/vault_text_secondary"
            android:textSize="@dimen/alerts_card_message_size" />

        <TextView
            android:id="@+id/textAlertCredentialRiskDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/vault_text_secondary"
            android:textSize="@dimen/alerts_card_message_size" />

    </LinearLayout>

    <!-- Open Credential Details -->
    <ImageView
        android:id="@+id/imageAlertChevron"
        android:layout_width="@dimen/alerts_card_chevron_size"
        android:layout_height="@dimen/alerts_card_chevron_size"
        android:layout_marginStart="@dimen/alerts_card_chevron_gap"
        android:contentDescription="@null"
        android:src="@drawable/ic_alerts_chevron" />

</LinearLayout>
