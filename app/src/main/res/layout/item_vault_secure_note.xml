<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/vault_card_bg"
    android:minHeight="82dp"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/textNoteIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/vault_logo_bg"
        android:gravity="center"
        android:text="@string/secure_note_icon_letter"
        android:textColor="@color/vault_chip_text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textNoteTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/vault_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textNoteIcon"
        app:layout_constraintTop_toTopOf="@id/textNoteIcon"
        tools:text="Wi-Fi backup codes" />

    <TextView
        android:id="@+id/textNotePreview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/vault_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/textNoteTitle"
        app:layout_constraintStart_toStartOf="@id/textNoteTitle"
        app:layout_constraintTop_toBottomOf="@id/textNoteTitle"
        tools:text="Emergency network information and recovery details..." />

</androidx.constraintlayout.widget.ConstraintLayout>