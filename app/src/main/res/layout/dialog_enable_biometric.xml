<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/biometricEnrollmentDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/auth_card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Biometric icon -->
    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/vault_empty_icon_bg">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_fingerprint" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/fraunces_semibold"
        android:gravity="center"
        android:text="@string/biometric_enable_title"
        android:textColor="@color/auth_text_primary"
        android:textSize="21sp" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/biometric_enable_message"
        android:textColor="@color/auth_text_secondary"
        android:textSize="14sp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonBiometricNotNow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/biometric_dialog_secondary_button_bg"
            app:backgroundTint="@null"
            android:text="@string/biometric_not_now"
            android:textAllCaps="false"
            android:textColor="@color/auth_text_secondary"
            android:textSize="14sp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/buttonBiometricEnable"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/auth_primary_button_bg"
            app:backgroundTint="@null"
            android:text="@string/biometric_enable"
            android:textAllCaps="false"
            android:textColor="@color/auth_primary_button_text"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>