<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/vault_card_bg"
    android:minHeight="88dp"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <!-- Website/app logo area + optional security risk dot -->
    <FrameLayout
        android:id="@+id/logoArea"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/vault_logo_bg">

            <ImageView
                android:id="@+id/imageCredentialLogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:visibility="gone"
                tools:src="@drawable/ic_launcher_foreground"
                tools:visibility="visible" />

            <!-- Fallback when no site icon is available -->
            <TextView
                android:id="@+id/textCredentialLogoFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/vault_chip_text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="G" />

        </FrameLayout>

        <View
            android:id="@+id/viewRiskDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:background="@drawable/vault_risk_dot_red"
            android:contentDescription="@string/vault_breach_content_description"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <TextView
        android:id="@+id/textCredentialName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/vault_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/buttonFavorite"
        app:layout_constraintStart_toEndOf="@id/logoArea"
        app:layout_constraintTop_toTopOf="@id/logoArea"
        tools:text="Google" />

    <TextView
        android:id="@+id/textCredentialUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/vault_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/textCredentialName"
        app:layout_constraintStart_toStartOf="@id/textCredentialName"
        app:layout_constraintTop_toBottomOf="@id/textCredentialName"
        tools:text="user@gmail.com" />

    <TextView
        android:id="@+id/textCredentialDomain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/vault_text_faint"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/textCredentialName"
        app:layout_constraintStart_toStartOf="@id/textCredentialName"
        app:layout_constraintTop_toBottomOf="@id/textCredentialUsername"
        tools:text="accounts.google.com" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/buttonFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/vault_favorite_content_description"
        android:padding="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_vault_star_outline" />

</androidx.constraintlayout.widget.ConstraintLayout>