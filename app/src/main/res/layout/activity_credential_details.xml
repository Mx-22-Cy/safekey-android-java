<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCredentialDetails"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_background">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonBackCredentialDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/credential_details_back"
                    android:textColor="@color/vault_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/credential_details_title"
                    android:textColor="@color/vault_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Credential identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textCredentialDetailsLogo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/vault_logo_bg"
                    android:gravity="center"
                    android:textColor="@color/vault_chip_text_dark"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="G" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textCredentialDetailsName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/vault_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Google" />

                    <TextView
                        android:id="@+id/textCredentialDetailsDomain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/vault_text_secondary"
                        android:textSize="12sp"
                        tools:text="accounts.google.com" />

                </LinearLayout>

            </LinearLayout>

            <!-- Username -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credential_details_username"
                android:textColor="@color/vault_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCredentialDetailsUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/vault_field_bg"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/vault_text_primary"
                android:textSize="14sp"
                tools:text="user@gmail.com" />

            <!-- Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credential_details_password"
                android:textColor="@color/vault_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/textCredentialDetailsPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/vault_field_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="52dp"
                    android:textColor="@color/vault_text_primary"
                    android:textSize="14sp"
                    tools:text="••••••••••••" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonToggleDetailsPassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/show_password_content_description"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_password_visible" />

            </FrameLayout>

            <!-- Website -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credential_details_website"
                android:textColor="@color/vault_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCredentialDetailsWebsite"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/vault_field_bg"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/vault_text_primary"
                android:textSize="14sp"
                tools:text="accounts.google.com" />

            <!-- Category -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credential_details_category"
                android:textColor="@color/vault_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCredentialDetailsCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/vault_field_bg"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/vault_text_primary"
                android:textSize="14sp"
                tools:text="Login" />

            <!-- Notes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credential_details_notes"
                android:textColor="@color/vault_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCredentialDetailsNotes"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/vault_field_bg"
                android:gravity="top|start"
                android:padding="14dp"
                android:textColor="@color/vault_text_primary"
                android:textSize="14sp"
                tools:text="Personal account." />

            <!-- Edit -->
            <TextView
                android:id="@+id/buttonEditCredential"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/vault_add_credential_bg"
                android:gravity="center"
                android:text="@string/credential_details_edit"
                android:textColor="@color/vault_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Delete -->
            <TextView
                android:id="@+id/buttonDeleteCredential"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/credential_details_delete"
                android:textColor="@android:color/holo_red_light"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>