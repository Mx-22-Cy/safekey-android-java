<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/auth_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="52dp" android:paddingBottom="30dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <ImageButton android:id="@+id/buttonBackRecovery" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:clickable="true" android:focusable="true" android:src="@drawable/t43_back_arrow_icon" android:background="@drawable/t43_outlined_button_bg" android:contentDescription="@string/t43_back_to_signup" app:backgroundTint="@null"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:layout_height="wrap_content" android:fontFamily="@font/fraunces_semibold" android:text="@string/t43_save_recovery_title" android:textSize="25sp" android:textColor="@color/auth_text_primary"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="20dp" android:text="@string/t43_save_recovery_intro" android:textSize="14sp" android:textColor="@color/auth_text_secondary"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/auth_card_bg" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/t43_recovery_key_label" android:textColor="@color/auth_text_primary" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/textRecoveryKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="12dp" android:background="@drawable/auth_input_bg" android:gravity="center" android:fontFamily="monospace" android:textSize="18sp" android:letterSpacing="0.05" android:lineSpacingExtra="8dp" android:textColor="@color/auth_text_primary" android:textIsSelectable="false" android:importantForAccessibility="no"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:lineSpacingExtra="7dp" android:text="@string/t43_recovery_instructions" android:textSize="14sp" android:textColor="@color/auth_text_secondary"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/recovery_warning_card" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/t43_important" android:textStyle="bold" android:textSize="14sp" android:textColor="#E5848A"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:text="@string/t43_recovery_loss_warning" android:textColor="@color/auth_text_secondary"/>
        </LinearLayout>
        <CheckBox android:id="@+id/checkRecoverySaved" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:minHeight="54dp" android:text="@string/t43_recovery_saved_confirmation" android:buttonTint="@color/auth_checkbox_tint" android:textColor="@color/auth_text_primary" android:textSize="14sp"/>
        <Button android:id="@+id/buttonConfirmRecovery" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:enabled="false" android:background="@drawable/auth_primary_button_bg" app:backgroundTint="@null" android:text="@string/t43_continue_create_vault" android:textAllCaps="false" android:textColor="@color/auth_primary_button_text" android:textSize="16sp"/>
        <Button android:id="@+id/buttonCancelRecovery" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/auth_secondary_button_bg" app:backgroundTint="@null" android:text="@string/t43_cancel_setup" android:textAllCaps="false" android:textColor="@color/auth_accent" android:textSize="14sp"/>
    </LinearLayout>
</ScrollView>
