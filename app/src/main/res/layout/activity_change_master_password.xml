<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootChangeMasterPassword"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fraunces_semibold"
            android:text="@string/master_password_change_title"
            android:textColor="@color/auth_text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/master_password_change_description"
            android:textColor="@color/auth_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/editCurrentMasterPassword"
            android:text="@string/master_password_current_label"
            android:textColor="@color/auth_text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editCurrentMasterPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:singleLine="true"
            android:textColor="@color/auth_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/editNewMasterPassword"
            android:text="@string/master_password_new_label"
            android:textColor="@color/auth_text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editNewMasterPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:singleLine="true"
            android:textColor="@color/auth_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/editConfirmNewMasterPassword"
            android:text="@string/master_password_confirm_label"
            android:textColor="@color/auth_text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editConfirmNewMasterPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:singleLine="true"
            android:textColor="@color/auth_text_primary" />

        <TextView
            android:id="@+id/textMasterPasswordChangeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/auth_text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonSaveMasterPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/master_password_save" />

        <Button
            android:id="@+id/buttonCancelMasterPasswordChange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@android:string/cancel" />
    </LinearLayout>
</ScrollView>
