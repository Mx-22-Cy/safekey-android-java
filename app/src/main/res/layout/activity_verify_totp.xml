<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootVerifyTotp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonVerifyTotpTopBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/t27_outline_button_bg"
                    android:contentDescription="@string/t39_back"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/auth_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/fraunces_semibold"
                    android:text="@string/t39_verify_title"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/t39_verify_description"
                android:textColor="@color/auth_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/cardVerifyTotp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/auth_card_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- The Activity updates this from the existing pending setup lifetime. -->
                <TextView
                    android:id="@+id/textVerifyTotpCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/t27_outline_button_bg"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="@string/t39_time_limit"
                    android:textColor="@color/auth_text_secondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/editVerifyTotpCode"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/auth_input_bg"
                    android:digits="0123456789"
                    android:gravity="center"
                    android:hint="@string/t39_code_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:padding="12dp"
                    android:saveEnabled="false"
                    android:singleLine="true"
                    android:textColor="@color/auth_text_primary"
                    android:textColorHint="@color/auth_text_secondary"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/textVerifyTotpError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="@color/dashboard_alert_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/buttonVerifyTotpBack"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/t27_outline_button_bg"
            android:text="@string/t39_verification_back"
            android:textAllCaps="false"
            android:textColor="@color/auth_text_secondary"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/buttonEnableTotpProtection"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/auth_primary_button_bg"
            android:enabled="false"
            android:text="@string/t39_verify_button"
            android:textAllCaps="false"
            android:textColor="@color/auth_primary_button_text"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
