<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAddCredential"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_background">

    <ScrollView
        android:id="@+id/scrollAddCredential"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textAddCredentialTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_credential_title"
                    android:textColor="@color/vault_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/buttonCancelAddCredential"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/add_credential_cancel"
                    android:textColor="@color/vault_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/textAddCredentialSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="@string/add_credential_subtitle"
                android:textColor="@color/vault_text_secondary"
                android:textSize="14sp" />

            <!-- Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_credential_name_label"
                android:textColor="@color/vault_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/editCredentialName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/vault_field_bg"
                android:hint="@string/add_credential_name_hint"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/vault_text_primary"
                android:textColorHint="@color/vault_text_faint"
                android:textSize="14sp" />

            <!-- Username -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_credential_username_label"
                android:textColor="@color/vault_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/editCredentialUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/vault_field_bg"
                android:hint="@string/add_credential_username_hint"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/vault_text_primary"
                android:textColorHint="@color/vault_text_faint"
                android:textSize="14sp" />

            <!-- Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_credential_password_label"
                android:textColor="@color/vault_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/editCredentialPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/vault_field_bg"
                    android:hint="@string/add_credential_password_hint"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="52dp"
                    android:singleLine="true"
                    android:textColor="@color/vault_text_primary"
                    android:textColorHint="@color/vault_text_faint"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonToggleCredentialPassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/show_password_content_description"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_password_visible" />

            </FrameLayout>

            <!-- Website -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_credential_website_label"
                android:textColor="@color/vault_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/editCredentialWebsite"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/vault_field_bg"
                android:hint="@string/add_credential_website_hint"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/vault_text_primary"
                android:textColorHint="@color/vault_text_faint"
                android:textSize="14sp" />

            <!-- Category -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_credential_category_label"
                android:textColor="@color/vault_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/editCredentialCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/vault_field_bg"
                android:hint="@string/add_credential_category_hint"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/vault_text_primary"
                android:textColorHint="@color/vault_text_faint"
                android:textSize="14sp" />

            <!-- Notes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_credential_notes_label"
                android:textColor="@color/vault_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/editCredentialNotes"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="26dp"
                android:background="@drawable/vault_field_bg"
                android:gravity="top|start"
                android:hint="@string/add_credential_notes_hint"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/vault_text_primary"
                android:textColorHint="@color/vault_text_faint"
                android:textSize="14sp" />

            <!-- Save -->
            <TextView
                android:id="@+id/buttonSaveCredential"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/vault_add_credential_bg"
                android:gravity="center"
                android:text="@string/add_credential_save"
                android:textColor="@color/vault_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>