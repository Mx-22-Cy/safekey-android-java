<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSetupTotp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonTotpBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/t27_outline_button_bg"
                    android:contentDescription="@string/t39_back"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/auth_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/fraunces_semibold"
                    android:text="@string/t39_title"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="@dimen/t39_text_title" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/t39_description"
                android:textColor="@color/t39_secondary_text"
                android:textSize="@dimen/t39_text_body" />

            <!-- QR Code Card -->

            <LinearLayout
                android:id="@+id/cardTotpQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/auth_card_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/t39_setup_description"
                    android:textColor="@color/t39_secondary_text"
                    android:textSize="@dimen/t39_text_instruction" />

                <!-- Populated only after authorized enrollment starts -->

                <ImageView
                    android:id="@+id/imageTotpQrCode"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    android:background="@android:color/white"
                    android:contentDescription="@string/t39_qr_accessibility"
                    android:padding="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textTotpQrPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/t39_not_enabled"
                    android:textColor="@color/t39_secondary_text"
                    android:textSize="@dimen/t39_text_instruction" />

                <!-- Five-minute enrollment countdown -->

                <TextView
                    android:id="@+id/textTotpCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/t27_outline_button_bg"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="@string/t39_time_limit"
                    android:textColor="@color/t39_secondary_text"
                    android:textSize="@dimen/t39_text_small" />

            </LinearLayout>

            <!-- Manual Key Section -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/t39_manual_key_description"
                android:textColor="@color/auth_text_primary"
                android:textSize="@dimen/t39_text_small"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonToggleTotpKey"
                android:textSize="@dimen/t39_text_small"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/t27_outline_button_bg"
                android:enabled="false"
                android:text="@string/t39_show_key"
                android:textAllCaps="false"
                android:textColor="@color/auth_text_primary"
                app:backgroundTint="@null" />

            <LinearLayout
                android:id="@+id/groupTotpManualKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/auth_card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t39_manual_key_title"
                    android:textColor="@color/t39_secondary_text"
                    android:textSize="@dimen/t39_text_small"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textTotpManualKey"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/auth_input_bg"
                        android:gravity="center"
                        android:padding="12dp"
                        android:saveEnabled="false"
                        android:text="@string/t39_manual_key_hidden"
                        android:textColor="@color/auth_text_primary"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/t39_text_small" />

                    <Button
                        android:id="@+id/buttonCopyTotpKey"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/t27_outline_button_bg"
                        android:enabled="false"
                        android:minWidth="76dp"
                        android:text="@string/t39_manual_key_title"
                        android:textAllCaps="false"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="@dimen/t39_text_note"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/t39_security_warning"
                    android:textColor="@color/dashboard_alert_text"
                    android:textSize="@dimen/t39_text_note" />

            </LinearLayout>

            <!-- Error Feedback -->

            <TextView
                android:id="@+id/textTotpSetupError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/dashboard_alert_text"
                android:textSize="@dimen/t39_text_note"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Actions -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/buttonCancelTotpSetup"
            android:textSize="@dimen/t39_text_small"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/t27_outline_button_bg"
            android:text="@string/t39_cancel"
            android:textAllCaps="false"
            android:textColor="@color/t39_secondary_text"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/buttonContinueTotpSetup"
            android:textSize="@dimen/t39_text_small"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/t39_primary_button_background"
            android:enabled="false"
            android:text="@string/t39_verify_title"
            android:textAllCaps="false"
            android:textColor="@color/t39_primary_button_text"
            app:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>
