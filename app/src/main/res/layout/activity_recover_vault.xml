<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootRecoverVault" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/auth_background"><ScrollView android:id="@+id/recoveryInputScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="30dp" android:id="@+id/recoveryForm">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <ImageButton android:id="@+id/buttonBackRecovery" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:clickable="true" android:focusable="true" android:src="@drawable/t43_back_arrow_icon" android:background="@drawable/t43_outlined_button_bg" android:contentDescription="@string/t43_back_to_signin" app:backgroundTint="@null"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:layout_height="wrap_content" android:fontFamily="@font/fraunces_semibold" android:text="@string/t43_recover_title" android:textColor="@color/auth_text_primary" android:textSize="25sp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/t43_recover_intro" android:textColor="@color/auth_text_secondary" android:textSize="14sp"/>

        <LinearLayout android:id="@+id/recoveryFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/auth_card_bg" android:padding="20dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/t43_recovery_input_label" android:textColor="@color/auth_text_primary" android:textStyle="bold" android:textSize="14sp"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="8dp"><EditText android:id="@+id/editRecoveryKey" android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="82dp" android:background="@drawable/auth_input_bg" android:hint="@string/t43_recovery_key_hint" android:importantForAutofill="no" android:inputType="textPassword|textMultiLine|textNoSuggestions" android:singleLine="false" android:maxLines="2" android:scrollHorizontally="false" android:gravity="center_vertical|start" android:fontFamily="monospace" android:paddingStart="14dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:textSize="14sp" android:textColor="@color/auth_text_primary" android:textColorHint="@color/auth_text_hint_signin" android:maxLength="39" android:saveEnabled="false" android:paddingEnd="50dp"/>
                <ImageButton android:id="@+id/buttonEyeRecoveryKey" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:background="@android:color/transparent" android:padding="13dp" android:src="@drawable/ic_visibility" android:contentDescription="@string/t43_toggle_recovery_key"/></FrameLayout><CheckBox android:id="@+id/checkShowRecoveryKey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t43_show_recovery_key" android:textColor="@color/auth_text_secondary" android:textSize="12sp" android:visibility="gone"/>
                <TextView android:id="@+id/textRecoveryKeyError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E5848A" android:textSize="12sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/t43_new_master_password" android:textColor="@color/auth_text_primary" android:textStyle="bold" android:textSize="14sp"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp"><EditText android:id="@+id/editNewRecoveryPassword" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/auth_input_bg" android:hint="@string/t43_new_master_password_hint" android:importantForAutofill="no" android:inputType="textPassword" android:paddingStart="14dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:textColor="@color/auth_text_primary" android:textColorHint="@color/auth_text_hint_signin" android:saveEnabled="false" android:paddingEnd="50dp"/>
                <ImageButton android:id="@+id/buttonEyeNewRecoveryPassword" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:background="@android:color/transparent" android:padding="13dp" android:src="@drawable/ic_visibility" android:contentDescription="@string/t43_toggle_new_password"/></FrameLayout><LinearLayout android:id="@+id/recoveryStrengthMeter" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp" android:orientation="horizontal"><View android:id="@+id/recoveryStrengthSegment1" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#303849"/><View android:id="@+id/recoveryStrengthSegment2" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#303849"/><View android:id="@+id/recoveryStrengthSegment3" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#303849"/><View android:id="@+id/recoveryStrengthSegment4" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#303849"/><View android:id="@+id/recoveryStrengthSegment5" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#303849"/></LinearLayout><TextView android:id="@+id/textRecoveryStrength" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/auth_accent"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/t43_password_length_hint" android:textColor="@color/auth_text_secondary" android:textSize="12sp"/>
                <TextView android:id="@+id/textNewPasswordError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E5848A" android:textSize="12sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/t43_confirm_master_password" android:textColor="@color/auth_text_primary" android:textStyle="bold" android:textSize="14sp"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp"><EditText android:id="@+id/editConfirmRecoveryPassword" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/auth_input_bg" android:hint="@string/t43_confirm_password_hint" android:importantForAutofill="no" android:inputType="textPassword" android:paddingStart="14dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:textColor="@color/auth_text_primary" android:textColorHint="@color/auth_text_hint_signin" android:saveEnabled="false" android:paddingEnd="50dp"/>
                <ImageButton android:id="@+id/buttonEyeConfirmRecoveryPassword" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:background="@android:color/transparent" android:padding="13dp" android:src="@drawable/ic_visibility" android:contentDescription="@string/t43_toggle_confirm_password"/></FrameLayout><CheckBox android:id="@+id/checkShowRecoveryPasswords" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t43_show_passwords" android:textColor="@color/auth_text_secondary" android:textSize="12sp" android:visibility="gone"/>
                <TextView android:id="@+id/textConfirmPasswordError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E5848A" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="14dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/auth_card_bg">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="12dp" android:src="@drawable/t43_shield_check" android:contentDescription="@string/t43_secure_vault"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/t43_vault_preserved" android:textColor="@color/auth_text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:id="@+id/textRecoveryStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#E5848A" android:textSize="13sp"/>
            <Button android:id="@+id/buttonResetMasterPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/auth_primary_button_bg" app:backgroundTint="@null" android:text="@string/t43_reset_master_password" android:textAllCaps="false" android:textColor="@color/auth_primary_button_text" android:enabled="false"/>
            <Button android:visibility="gone" android:id="@+id/buttonCancelRecovery" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/t43_outlined_button_bg" app:backgroundTint="@null" android:text="@string/t43_back_to_signin" android:textAllCaps="false" android:textColor="@color/auth_accent"/>
        </LinearLayout>
        </LinearLayout>
</ScrollView><LinearLayout android:id="@+id/recoverySuccess" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:gravity="center" android:orientation="vertical" android:padding="28dp">
            <TextView android:layout_width="68dp" android:layout_height="68dp" android:layout_marginBottom="28dp" android:gravity="center" android:text="@string/t43_success_checkmark" android:textSize="36sp" android:textColor="@color/auth_accent" android:background="@drawable/recovery_success_circle" android:importantForAccessibility="no"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/fraunces_semibold" android:text="@string/t43_success_title" android:gravity="center" android:textSize="26sp" android:textColor="@color/auth_text_primary"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:textSize="14sp" android:text="@string/t43_success_message" android:textColor="@color/auth_text_secondary"/>
            <Button android:id="@+id/buttonRecoverySuccessSignIn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="32dp" android:background="@drawable/auth_primary_button_bg" app:backgroundTint="@null" android:text="@string/t43_go_to_signin" android:textAllCaps="false" android:textColor="@color/auth_primary_button_text"/>
        </LinearLayout>
    </FrameLayout>
