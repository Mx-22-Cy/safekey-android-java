<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSignIn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="52dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <!-- SafeKey brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_safekey_logo"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/fraunces_semibold"
                android:text="@string/app_name"
                android:textColor="@color/auth_text_primary"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/fraunces_semibold"
            android:text="@string/signin_title"
            android:textColor="@color/auth_text_primary"
            android:textSize="29sp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/signin_subtitle"
            android:textColor="@color/auth_text_secondary"
            android:textSize="14sp" />

        <!-- Password card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/auth_card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/labelMasterPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/editMasterPassword"
                android:text="@string/auth_master_password"
                android:textColor="@color/auth_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/editMasterPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/auth_input_bg"
                    android:hint="@string/auth_enter_master_password"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="52dp"
                    android:textColor="@color/auth_text_primary"
                    android:textColorHint="@color/auth_text_hint_signin"
                    android:textSize="15sp"
                    tools:ignore="LabelFor" />

                <ImageButton
                    android:id="@+id/buttonTogglePassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/show_password_content_description"
                    android:padding="12dp"
                    android:src="@drawable/ic_visibility" />

            </FrameLayout>

            <TextView
                android:id="@+id/textValidationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/auth_accent"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Unlock -->
        <Button
            android:id="@+id/buttonUnlockVault"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/auth_primary_button_bg"
            app:backgroundTint="@null"
            android:text="@string/signin_unlock_vault"
            android:textAllCaps="false"
            android:textColor="@color/auth_primary_button_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Create vault -->
        <Button
            android:id="@+id/buttonGoToSignUp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/auth_secondary_button_bg"
            app:backgroundTint="@null"
            android:text="@string/signin_create_vault"
            android:textAllCaps="false"
            android:textColor="@color/auth_accent"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>