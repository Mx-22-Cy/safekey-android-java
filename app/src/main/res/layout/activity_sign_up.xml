<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10141F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="52dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <!-- SafeKey brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="SafeKey logo"
                android:src="@drawable/ic_safekey_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="SafeKey"
                android:fontFamily="@font/fraunces_semibold"
                android:textColor="#ECEEF3"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Page title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Set up your vault"
            android:fontFamily="@font/fraunces_semibold"
            android:textColor="#ECEEF3"
            android:textSize="29sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your vault is designed to stay local and private."
            android:textColor="#8C93A8"
            android:textSize="15sp" />

        <!-- Password card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/auth_card_bg"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Master password"
                android:textColor="#ECEEF3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editMasterPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/auth_input_bg"
                android:hint="Enter master password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#ECEEF3"
                android:textColorHint="#5B6178"
                android:textSize="15sp" />

            <!-- Password strength meter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/strengthBar1"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="#2A3142" />

                <View
                    android:id="@+id/strengthBar2"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="#2A3142" />

                <View
                    android:id="@+id/strengthBar3"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="#2A3142" />

                <View
                    android:id="@+id/strengthBar4"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="#2A3142" />

                <View
                    android:id="@+id/strengthBar5"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="#2A3142" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="12+ characters. Mix letters, numbers and a symbol for a stronger vault."
                android:textColor="#5B6178"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textPasswordStrength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Confirm master password"
                android:textColor="#ECEEF3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/auth_input_bg"
                android:hint="Re-enter master password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#ECEEF3"
                android:textColorHint="#5B6178"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/checkShowPasswords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:buttonTint="@color/auth_checkbox_tint"
                android:text="Show passwords"
                android:textColor="#8C93A8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textValidationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#3ECF8E"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Create vault -->
        <Button
            android:id="@+id/buttonCreateVault"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/auth_primary_button_bg"
            app:backgroundTint="@null"
            android:text="Create vault"
            android:textAllCaps="false"
            android:textColor="#12261E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Sign in -->
        <Button
            android:id="@+id/buttonGoToSignIn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/auth_secondary_button_bg"
            app:backgroundTint="@null"
            android:text="Already have a vault? Sign in"
            android:textAllCaps="false"
            android:textColor="#3ECF8E"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>