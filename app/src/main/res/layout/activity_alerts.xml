<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAlerts"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_background">

    <!-- Security Alerts header -->
    <LinearLayout
        android:id="@+id/layoutAlertsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/alerts_screen_horizontal_padding"
        android:layout_marginTop="@dimen/alerts_header_top_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageAlertsHeaderIcon"
            android:layout_width="@dimen/alerts_header_icon_size"
            android:layout_height="@dimen/alerts_header_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_alerts_security" />

        <TextView
            android:id="@+id/textAlertsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/alerts_header_icon_gap"
            android:fontFamily="serif"
            android:text="@string/alerts_title"
            android:textColor="@color/vault_text_primary"
            android:textSize="@dimen/alerts_header_title_size" />

    </LinearLayout>

    <!-- Security Alerts filters -->
    <LinearLayout
        android:id="@+id/layoutAlertsFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/alerts_screen_horizontal_padding"
        android:layout_marginTop="@dimen/alerts_filter_top_margin"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutAlertsHeader">

        <TextView
            android:id="@+id/filterAlertsAll"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/alerts_filter_chip_height"
            android:background="@drawable/vault_chip_active_bg"
            android:gravity="center"
            android:paddingStart="@dimen/alerts_filter_chip_horizontal_padding"
            android:paddingEnd="@dimen/alerts_filter_chip_horizontal_padding"
            android:text="@string/alerts_filter_all"
            android:textColor="@color/vault_chip_text_dark"
            android:textSize="@dimen/alerts_filter_chip_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterAlertsBreached"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/alerts_filter_chip_height"
            android:layout_marginStart="@dimen/alerts_filter_chip_gap"
            android:background="@drawable/vault_chip_inactive_bg"
            android:gravity="center"
            android:paddingStart="@dimen/alerts_filter_chip_horizontal_padding"
            android:paddingEnd="@dimen/alerts_filter_chip_horizontal_padding"
            android:text="@string/alerts_filter_breached"
            android:textColor="@color/vault_text_secondary"
            android:textSize="@dimen/alerts_filter_chip_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterAlertsAttention"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/alerts_filter_chip_height"
            android:layout_marginStart="@dimen/alerts_filter_chip_gap"
            android:background="@drawable/vault_chip_inactive_bg"
            android:gravity="center"
            android:paddingStart="@dimen/alerts_filter_chip_horizontal_padding"
            android:paddingEnd="@dimen/alerts_filter_chip_horizontal_padding"
            android:text="@string/alerts_filter_attention"
            android:textColor="@color/vault_text_secondary"
            android:textSize="@dimen/alerts_filter_chip_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterAlertsPassed"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/alerts_filter_chip_height"
            android:layout_marginStart="@dimen/alerts_filter_chip_gap"
            android:background="@drawable/vault_chip_inactive_bg"
            android:gravity="center"
            android:paddingStart="@dimen/alerts_filter_chip_horizontal_padding"
            android:paddingEnd="@dimen/alerts_filter_chip_horizontal_padding"
            android:text="@string/alerts_filter_passed"
            android:textColor="@color/vault_text_secondary"
            android:textSize="@dimen/alerts_filter_chip_text_size"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable Security Alerts content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAlertsContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/alerts_content_top_margin"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="@dimen/alerts_screen_horizontal_padding"
        android:paddingEnd="@dimen/alerts_screen_horizontal_padding"
        android:paddingBottom="@dimen/alerts_content_bottom_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutAlertsFilters"
        app:layout_constraintBottom_toTopOf="@id/alertsNavDivider">


        <LinearLayout
            android:id="@+id/layoutAlertsSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textAlertsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/alerts_screen_horizontal_padding"
                android:textColor="@color/vault_text_secondary"
                android:textSize="@dimen/alerts_filter_chip_text_size"
                android:visibility="gone" />

            <!-- High Priority - Breached -->
            <LinearLayout
                android:id="@+id/layoutAlertsBreachedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section heading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/alerts_section_icon_size"
                        android:layout_height="@dimen/alerts_section_icon_size"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alerts_breached" />

                    <TextView
                        android:id="@+id/textAlertsBreachedHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/alerts_section_icon_gap"
                        android:text="@string/alerts_section_breached"
                        android:textColor="@color/vault_text_primary"
                        android:textSize="@dimen/alerts_section_heading_text_size"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Real breached credentials will appear here -->
                <LinearLayout
                    android:id="@+id/layoutAlertsBreachedCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/alerts_section_cards_top_margin"
                    android:orientation="vertical" />

            </LinearLayout>


            <!-- Needs Attention section -->
            <LinearLayout
                android:id="@+id/layoutAlertsAttentionSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alerts_section_spacing"
                android:orientation="vertical">

                <!-- Section heading and Retry All -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/alerts_section_icon_size"
                        android:layout_height="@dimen/alerts_section_icon_size"
                        android:src="@drawable/ic_vault_error_warning"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/textAlertsAttentionHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/alerts_section_icon_gap"
                        android:text="@string/alerts_section_attention"
                        android:textColor="@color/vault_text_primary"
                        android:textSize="@dimen/alerts_section_heading_text_size"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/buttonAlertsRetryAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_vault_retry"
                        android:drawablePadding="@dimen/alerts_section_icon_gap"
                        android:gravity="center_vertical"
                        android:text="@string/alerts_retry_all"
                        android:textColor="@color/vault_accent"
                        android:textSize="@dimen/alerts_retry_text_size"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Real credentials needing attention will appear here -->
                <LinearLayout
                    android:id="@+id/layoutAlertsAttentionCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/alerts_section_cards_top_margin"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- No Known Breach section -->
            <LinearLayout
                android:id="@+id/layoutAlertsPassedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alerts_section_spacing"
                android:orientation="vertical">

                <!-- Section heading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/alerts_section_icon_size"
                        android:layout_height="@dimen/alerts_section_icon_size"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alerts_passed" />

                    <TextView
                        android:id="@+id/textAlertsPassedHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/alerts_section_icon_gap"
                        android:text="@string/alerts_section_passed"
                        android:textColor="@color/vault_text_primary"
                        android:textSize="@dimen/alerts_section_heading_text_size"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Actual credentials with no known breach match -->
                <LinearLayout
                    android:id="@+id/layoutAlertsPassedCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/alerts_section_cards_top_margin"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- Bottom navigation divider -->
    <View
        android:id="@+id/alertsNavDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/alerts_nav_divider_height"
        android:background="@color/vault_panel_border"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationAlerts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fixed bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigationAlerts"
        android:layout_width="0dp"
        android:layout_height="@dimen/alerts_nav_height"
        android:background="@color/vault_panel"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="@dimen/alerts_nav_padding_top"
        android:paddingBottom="@dimen/alerts_nav_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/alerts_nav_icon_size"
                android:layout_height="@dimen/alerts_nav_icon_size"
                app:srcCompat="@drawable/ic_home"
                app:tint="@color/vault_text_faint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alerts_nav_label_top_margin"
                android:text="@string/home_nav_home"
                android:textColor="@color/vault_text_faint"
                android:textSize="@dimen/alerts_nav_label_size" />

        </LinearLayout>

        <!-- Vault -->
        <LinearLayout
            android:id="@+id/navVault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/alerts_nav_icon_size"
                android:layout_height="@dimen/alerts_nav_icon_size"
                app:srcCompat="@drawable/ic_vault"
                app:tint="@color/vault_text_faint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alerts_nav_label_top_margin"
                android:text="@string/home_nav_vault"
                android:textColor="@color/vault_text_faint"
                android:textSize="@dimen/alerts_nav_label_size" />

        </LinearLayout>

        <!-- Generator -->
        <LinearLayout
            android:id="@+id/navGenerator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/alerts_nav_icon_size"
                android:layout_height="@dimen/alerts_nav_icon_size"
                app:srcCompat="@drawable/ic_generate_password"
                app:tint="@color/vault_text_faint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alerts_nav_label_top_margin"
                android:text="@string/generator_title"
                android:textColor="@color/vault_text_faint"
                android:textSize="@dimen/alerts_nav_label_size" />

        </LinearLayout>

        <!-- Alerts selected -->
        <LinearLayout
            android:id="@+id/navAlerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/alerts_nav_active_width"
                android:layout_height="@dimen/alerts_nav_active_height"
                android:background="@drawable/vault_nav_active_bg">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/alerts_nav_active_icon_size"
                    android:layout_height="@dimen/alerts_nav_active_icon_size"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_alerts"
                    app:tint="@color/vault_accent" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alerts_nav_active_label_top_margin"
                android:text="@string/home_nav_alerts"
                android:textColor="@color/vault_accent"
                android:textSize="@dimen/alerts_nav_label_size"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/alerts_nav_icon_size"
                android:layout_height="@dimen/alerts_nav_icon_size"
                app:srcCompat="@drawable/ic_settings"
                app:tint="@color/vault_text_faint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alerts_nav_label_top_margin"
                android:text="@string/home_nav_settings"
                android:textColor="@color/vault_text_faint"
                android:textSize="@dimen/alerts_nav_label_size" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
