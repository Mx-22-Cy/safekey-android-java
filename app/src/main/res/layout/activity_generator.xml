<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGenerator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonBackGenerator"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/generator_back_content_description"
                    android:padding="8dp"
                    app:srcCompat="@drawable/ic_arrow_back" />

                <TextView
                    android:id="@+id/textGeneratorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fraunces_semibold"
                    android:text="@string/generator_title"
                    android:textColor="@color/vault_text_primary"
                    android:textSize="26sp" />

            </LinearLayout>

            <!-- Password card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/vault_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/textGeneratedPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:maxLines="3"
                        android:background="@drawable/vault_field_bg"
                        android:contentDescription="@string/generator_password_content_description"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="52dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/vault_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/buttonToggleGeneratedPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/show_password_content_description"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_password_visible" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/generator_strength_label"
                        android:textColor="@color/vault_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textStrengthLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/vault_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressPasswordStrength"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:progressTint="@color/vault_accent"
                    android:progressBackgroundTint="@color/vault_field_border" />

                <TextView
                    android:id="@+id/textStrengthFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vault_text_faint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/buttonCopyPassword"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/dashboard_secondary_button_bg"
                        android:gravity="center"
                        android:text="@string/generator_copy"
                        android:textColor="@color/vault_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/buttonRegeneratePassword"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/dashboard_secondary_button_bg"
                        android:gravity="center"
                        android:text="@string/generator_regenerate"
                        android:textColor="@color/vault_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/buttonUsePassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/auth_primary_button_bg"
                    android:gravity="center"
                    android:text="@string/generator_use_password"
                    android:textColor="@color/auth_primary_button_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Password Length -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/vault_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/generator_password_length"
                        android:textColor="@color/vault_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textPasswordLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/vault_accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekPasswordLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:progressTint="@color/vault_accent"
                    android:thumbTint="@color/vault_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textPasswordLengthMin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/vault_text_faint"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/textPasswordLengthMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/vault_text_faint"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Character Types -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/vault_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/generator_character_types"
                    android:textColor="@color/vault_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkUppercase"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/generator_uppercase"
                    android:textColor="@color/vault_text_primary"
                    android:buttonTint="@color/vault_accent" />

                <CheckBox
                    android:id="@+id/checkLowercase"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/generator_lowercase"
                    android:textColor="@color/vault_text_primary"
                    android:buttonTint="@color/vault_accent" />

                <CheckBox
                    android:id="@+id/checkNumbers"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/generator_numbers"
                    android:textColor="@color/vault_text_primary"
                    android:buttonTint="@color/vault_accent" />

                <CheckBox
                    android:id="@+id/checkSymbols"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/generator_symbols"
                    android:textColor="@color/vault_text_primary"
                    android:buttonTint="@color/vault_accent" />

                <TextView
                    android:id="@+id/textCharacterTypeHelper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/generator_character_type_required"
                    android:textColor="@color/vault_text_faint"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigationGenerator"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/vault_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_home"
                app:tint="@color/vault_text_faint"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/home_nav_home"
                android:textColor="@color/vault_text_faint"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navVault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_vault"
                app:tint="@color/vault_text_faint"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/home_nav_vault"
                android:textColor="@color/vault_text_faint"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navGenerator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:background="@drawable/vault_nav_active_bg">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_generate_password"
                    app:tint="@color/vault_accent"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/generator_nav"
                android:textColor="@color/vault_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAlerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_alerts"
                app:tint="@color/vault_text_faint"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/home_nav_alerts"
                android:textColor="@color/vault_text_faint"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/vault_text_faint"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_nav_settings"
                android:textColor="@color/vault_text_faint"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>