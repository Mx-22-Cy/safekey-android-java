<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:name=".SafeKeyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeKey">

        <activity
            android:name=".PanicStartupActivity"
            android:exported="false" />

        <!--
            Week 2 authentication UI.
            SignUpActivity remains the temporary launcher
            until the final authentication/navigation
            integration is completed.
        -->
        <activity
            android:name=".auth.SignUpActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".auth.SignInActivity"
            android:exported="false" />

        <activity
            android:name=".auth.ChangeMasterPasswordActivity"
            android:exported="false" />

        <!--
            Week 3 Home / Dashboard.
            It is not externally launchable.
        -->
        <activity
            android:name=".home.HomeActivity"
            android:exported="false" />

        <!-- Week 4 Vault -->
        <activity
            android:name=".vault.VaultActivity"
            android:exported="false" />

        <activity
            android:name=".vault.AddCredentialActivity"
            android:exported="false" />

        <activity
            android:name=".generator.GeneratorActivity"
            android:exported="false" />

        <!-- Week 9 Security Alerts -->
        <activity
            android:name=".alerts.AlertsActivity"
            android:exported="false" />

        <activity
            android:name=".vault.CredentialDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".vault.SecureNoteDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".vault.AddSecureNoteActivity"
            android:exported="false" />

        <!--
            MainActivity is kept for later integration.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
